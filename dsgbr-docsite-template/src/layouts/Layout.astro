---
import { config, todos, resolver } from '../lib/tokens';
interface Props {
  title?: string;
  section?: 'dashboard' | 'tokens' | 'components' | 'support';
  subNav?: Array<{ label: string; href: string; id: string }>;
  pageTitle?: string;
  pageDesc?: string;
}
const { title = 'DST', section = 'dashboard', subNav = [], pageTitle, pageDesc } = Astro.props;
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const familia = String(resolver(todos.find((t) => t.nombre === 'Familia/Marca') ?? { valor: 'Inter', modos: {}, modoBase: 'Valor' } as any));
const iniciales = (config.marca ?? 'DS').split(/\s+/).map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — {config.cliente ?? 'Sistema de Diseño'}</title>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=${encodeURIComponent(familia)}:wght@400;500;600;700&display=swap`} />
  <link rel="stylesheet" href={`${base}/descargas/tokens.css`} />
</head>
<body>
  <div class="app">

    <!-- ── Sidebar ── -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <div class="logo-icon">{iniciales}</div>
        <span class="logo-text">{config.marca ?? 'Sistema de Diseño'}</span>
      </div>

      <nav class="sidebar-nav">
        <a href={`${base}/`} class:list={['nav-item', { active: section === 'dashboard' }]}>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <rect x="1.5" y="1.5" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <rect x="10" y="1.5" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <rect x="1.5" y="10" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
            <rect x="10" y="10" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span>Dashboard</span>
        </a>

        <a href={`${base}/tokens/colors`} class:list={['nav-item', { active: section === 'tokens' }]}>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <circle cx="9" cy="9" r="7.25" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="9" cy="9" r="3.5" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="9" cy="9" r="1" fill="currentColor"/>
          </svg>
          <span>Tokens</span>
        </a>

        <a href={`${base}/components/buttons`} class:list={['nav-item', { active: section === 'components' }]}>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 1.5L16.5 5.5V12.5L9 16.5L1.5 12.5V5.5L9 1.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M9 1.5V16.5M1.5 5.5L9 9.5L16.5 5.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span>Components</span>
        </a>

        <div class="nav-divider"></div>

        <a href={`${base}/support`} class:list={['nav-item', { active: section === 'support' }]}>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 15.5C9 15.5 1.5 10.8 1.5 6C1.5 3.52 3.52 1.5 6 1.5C7.38 1.5 8.61 2.14 9 3C9.39 2.14 10.62 1.5 12 1.5C14.48 1.5 16.5 3.52 16.5 6C16.5 10.8 9 15.5 9 15.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
          <span>Support us</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <div class="sidebar-version">v{config.version} · {String(config.generado ?? '').slice(0, 4)}</div>
      </div>
    </aside>

    <!-- ── Main ── -->
    <main class="main">
      <!-- Sub-nav -->
      {subNav.length > 0 && (
        <div class="sub-nav">
          {subNav.map(item => (
            <a
              href={`${base}${item.href}`}
              class:list={['sub-nav-item', { active: pathname.endsWith(item.id) || pathname.includes(`/${item.id}`) }]}
            >
              {item.label}
            </a>
          ))}
        </div>
      )}

      <!-- Page header -->
      {pageTitle && (
        <div class="page-header">
          <h1 class="page-title">{pageTitle}</h1>
          {pageDesc && <p class="page-desc">{pageDesc}</p>}
        </div>
      )}

      <!-- Content -->
      <div class="content">
        <slot />
      </div>
    </main>
  </div>

  <script>
    // ── Copy to clipboard ──
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-copy]');
      if (!btn) return;
      const text = btn.dataset.copy;
      navigator.clipboard.writeText(text).then(() => {
        const original = btn.innerHTML;
        btn.innerHTML = `<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Copiado`;
        btn.classList.add('copied');
        setTimeout(() => { btn.innerHTML = original; btn.classList.remove('copied'); }, 1800);
      });
    });

    // ── Search filter ──
    const searchInput = document.getElementById('search');
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const q = searchInput.value.toLowerCase();
        document.querySelectorAll('[data-searchable]').forEach(el => {
          const text = el.dataset.searchable.toLowerCase();
          el.style.display = text.includes(q) ? '' : 'none';
        });
      });
    }
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --sidebar-w: 240px;
    --prim-100: var(--color-brand-100, #ebf7f7); --prim-500: var(--color-brand-500, #51a3a3); --prim-600: var(--color-brand-600, #3d8282);
    --prim-700: var(--color-brand-700, #2c6262); --prim-800: var(--color-brand-800, #1c4242);
    --sec-500: var(--color-secondary-500, var(--color-neutral-400, #dfcc74)); --sec-600: var(--color-secondary-600, var(--color-neutral-500, #c3b055));
    --neutral-50: var(--color-neutral-50, #f9f9f9); --neutral-100: var(--color-neutral-100, #f2f3f4);
    --neutral-200: var(--color-neutral-200, #e4e5e8); --neutral-300: var(--color-neutral-300, #cbcdd2);
    --neutral-400: var(--color-neutral-400, #9ea3ab); --neutral-500: var(--color-neutral-500, #727880);
    --neutral-700: var(--color-neutral-700, #3d4349); --neutral-900: var(--color-neutral-900, #151a1f);
    --txt-primary: var(--neutral-900); --txt-secondary: var(--neutral-700);
    --txt-tertiary: var(--neutral-500); --txt-disabled: var(--neutral-400);
    --surface-page: var(--neutral-50); --surface-base: var(--neutral-100);
    --border: var(--neutral-200); --border-emphasis: var(--neutral-400);
    --shadow-low: var(--shadow-n1, 0 1px 2px rgba(0,0,0,.08), 0 2px 4px rgba(0,0,0,.05));
    --shadow-mid: var(--shadow-n2, 0 2px 4px rgba(0,0,0,.10), 0 4px 8px rgba(0,0,0,.07));
    --shadow-high: var(--shadow-n3, var(--shadow-n2, 0 4px 8px rgba(0,0,0,.12), 0 8px 16px rgba(0,0,0,.08)));
    --r-sm: var(--radius-xs, 4px); --r-md: var(--radius-s, 8px); --r-lg: var(--radius-l, 16px); --r-full: var(--radius-pill, 999px);
    --font-body: var(--font-family-brand, 'Inter'), system-ui, sans-serif;
    --font-display: var(--font-family-brand, 'Inter'), system-ui, sans-serif;
  }

  html, body { height: 100%; }
  body { font-family: var(--font-body); background: var(--surface-page); color: var(--txt-primary); font-size: 14px; line-height: 1.5; }

  /* ── App shell ── */
  .app { display: flex; min-height: 100vh; }

  /* ── Sidebar ── */
  .sidebar {
    width: var(--sidebar-w); flex-shrink: 0; background: #fff;
    border-right: 1px solid var(--border); display: flex; flex-direction: column;
    position: sticky; top: 0; height: 100vh; overflow-y: auto;
  }
  .sidebar-logo {
    display: flex; align-items: center; gap: 10px;
    padding: 20px 20px 16px; border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .logo-icon {
    width: 36px; height: 36px; border-radius: var(--r-md);
    background: linear-gradient(135deg, var(--prim-500), var(--prim-700));
    color: #fff; font-weight: 700; font-size: 13px;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .logo-text { font-size: 12px; font-weight: 600; color: var(--txt-primary); line-height: 1.3; }

  .sidebar-nav { flex: 1; padding: 12px 8px; display: flex; flex-direction: column; gap: 2px; }
  .nav-divider { height: 1px; background: var(--border); margin: 8px 8px; }

  .nav-item {
    display: flex; align-items: center; gap: 10px; padding: 9px 12px;
    border-radius: var(--r-md); text-decoration: none; color: var(--txt-secondary);
    font-size: 14px; font-weight: 500; transition: background .15s, color .15s;
    position: relative;
  }
  .nav-item:hover { background: var(--neutral-100); color: var(--txt-primary); }
  .nav-item.active {
    background: var(--prim-100); color: var(--prim-700); font-weight: 600;
  }
  .nav-item.active::before {
    content: ''; position: absolute; left: 0; top: 6px; bottom: 6px;
    width: 3px; background: var(--prim-500); border-radius: 0 2px 2px 0;
  }

  .sidebar-footer { padding: 16px 20px; border-top: 1px solid var(--border); flex-shrink: 0; }
  .sidebar-version { font-size: 11px; color: var(--txt-disabled); }

  /* ── Main ── */
  .main { flex: 1; display: flex; flex-direction: column; min-width: 0; }

  /* ── Sub-nav ── */
  .sub-nav {
    display: flex; align-items: center; gap: 0;
    background: #fff; border-bottom: 1px solid var(--border);
    padding: 0 32px; overflow-x: auto; flex-shrink: 0;
  }
  .sub-nav-item {
    padding: 14px 16px; font-size: 14px; font-weight: 500;
    color: var(--txt-tertiary); text-decoration: none;
    border-bottom: 2px solid transparent; white-space: nowrap;
    transition: color .15s, border-color .15s;
  }
  .sub-nav-item:hover { color: var(--txt-primary); }
  .sub-nav-item.active { color: var(--prim-600); border-bottom-color: var(--prim-500); }

  /* ── Page header ── */
  .page-header { padding: 32px 32px 0; }
  .page-title { font-size: 28px; font-weight: 700; color: var(--txt-primary); margin-bottom: 6px; }
  .page-desc { font-size: 14px; color: var(--txt-secondary); }

  /* ── Content ── */
  .content { padding: 28px 32px 48px; flex: 1; }

  /* ── Section label ── */
  .section-label {
    font-size: 11px; font-weight: 600; letter-spacing: .08em;
    text-transform: uppercase; color: var(--txt-tertiary);
    margin-bottom: 12px; margin-top: 32px;
  }
  .section-label:first-child { margin-top: 0; }

  /* ── Token grid ── */
  .token-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; margin-bottom: 8px; }
  .token-grid-wide { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }

  /* ── Token card ── */
  .token-card {
    background: #fff; border: 1px solid var(--border); border-radius: var(--r-md);
    overflow: hidden; box-shadow: var(--shadow-low);
    transition: box-shadow .15s;
  }
  .token-card:hover { box-shadow: var(--shadow-mid); }
  .token-swatch { height: 72px; }
  .token-body { padding: 10px 12px 12px; }
  .token-name { font-size: 12px; font-weight: 600; color: var(--txt-primary); margin-bottom: 2px; word-break: break-all; }
  .token-value { font-size: 11px; color: var(--txt-tertiary); font-family: 'Courier New', monospace; }
  .token-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }

  /* ── Copy button ── */
  .copy-btn {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 8px; border-radius: var(--r-sm);
    background: var(--neutral-100); border: 1px solid var(--border);
    font-size: 11px; font-weight: 500; color: var(--txt-secondary);
    cursor: pointer; transition: background .12s, color .12s;
    font-family: var(--font-body);
  }
  .copy-btn:hover { background: var(--neutral-200); color: var(--txt-primary); }
  .copy-btn.copied { background: #d1fae5; border-color: #6ee7b7; color: #065f46; }

  /* ── Group header ── */
  .group-header { display: flex; align-items: center; gap: 8px; margin: 24px 0 10px; }
  .group-title { font-size: 13px; font-weight: 600; color: var(--txt-secondary); }
  .group-count { font-size: 11px; color: var(--txt-disabled); background: var(--neutral-100); padding: 1px 6px; border-radius: var(--r-full); }

  /* ── Stat cards ── */
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px; }
  .stat-card {
    background: #fff; border: 1px solid var(--border); border-radius: var(--r-lg);
    padding: 20px 24px; box-shadow: var(--shadow-low);
  }
  .stat-number { font-size: 36px; font-weight: 700; color: var(--prim-600); line-height: 1; margin-bottom: 6px; }
  .stat-label { font-size: 14px; font-weight: 600; color: var(--txt-primary); margin-bottom: 2px; }
  .stat-sub { font-size: 12px; color: var(--txt-tertiary); }

  /* ── Code block ── */
  .code-block {
    background: var(--neutral-900); color: #e4e5e8; border-radius: var(--r-md);
    padding: 16px 20px; font-family: 'Courier New', monospace; font-size: 12px;
    line-height: 1.7; overflow-x: auto; position: relative;
  }
  .code-block .copy-btn { position: absolute; top: 10px; right: 10px; background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.2); color: #cbcdd2; }
  .code-block .copy-btn:hover { background: rgba(255,255,255,.2); color: #fff; }

  /* ── Component preview area ── */
  .preview-box {
    background: var(--surface-base); border: 1px solid var(--border);
    border-radius: var(--r-md); padding: 32px; display: flex;
    align-items: center; justify-content: center; flex-wrap: wrap; gap: 16px;
    margin-bottom: 12px;
  }
  .preview-label { font-size: 11px; color: var(--txt-tertiary); margin-bottom: 16px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }

  /* ── Search ── */
  .search-bar {
    display: flex; align-items: center; gap: 8px;
    background: var(--neutral-100); border: 1px solid var(--border);
    border-radius: var(--r-md); padding: 8px 14px; max-width: 320px;
    margin-bottom: 24px;
  }
  .search-bar input {
    border: none; background: transparent; font-size: 14px; color: var(--txt-primary);
    outline: none; flex: 1; font-family: var(--font-body);
  }
  .search-bar input::placeholder { color: var(--txt-disabled); }

  /* ── Table ── */
  .ds-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: var(--r-md); overflow: hidden; box-shadow: var(--shadow-low); border: 1px solid var(--border); }
  .ds-table th { background: var(--neutral-100); padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 600; color: var(--txt-tertiary); text-transform: uppercase; letter-spacing: .06em; border-bottom: 1px solid var(--border); }
  .ds-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); font-size: 13px; color: var(--txt-primary); vertical-align: middle; }
  .ds-table tr:last-child td { border-bottom: none; }
  .ds-table tr:hover td { background: var(--neutral-50); }
  .ds-table .mono { font-family: 'Courier New', monospace; font-size: 12px; color: var(--txt-secondary); }

  /* ── Tag / badge ── */
  .tag { display: inline-block; padding: 2px 8px; border-radius: var(--r-full); font-size: 11px; font-weight: 600; }
  .tag-neutral { background: var(--neutral-100); color: var(--txt-secondary); }
  .tag-primary { background: var(--prim-100); color: var(--prim-700); }

  /* ── Quick-link cards ── */
  .quick-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .quick-card {
    background: #fff; border: 1px solid var(--border); border-radius: var(--r-lg);
    padding: 20px; text-decoration: none; color: var(--txt-primary);
    box-shadow: var(--shadow-low); transition: box-shadow .15s, border-color .15s;
    display: flex; flex-direction: column; gap: 8px;
  }
  .quick-card:hover { box-shadow: var(--shadow-mid); border-color: var(--prim-500); }
  .quick-card-icon { font-size: 24px; line-height: 1; }
  .quick-card-title { font-size: 15px; font-weight: 600; }
  .quick-card-desc { font-size: 12px; color: var(--txt-tertiary); line-height: 1.5; }

  /* ── Component builder ── */
  .builder { display:grid; grid-template-columns:280px 1fr; border:1px solid var(--border); border-radius:var(--r-lg); overflow:hidden; }
  .builder-panel { padding:24px; background:#fff; border-right:1px solid var(--border); display:flex; flex-direction:column; gap:20px; }
  .builder-panel-title { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--txt-tertiary); margin-bottom:4px; }
  .builder-preview { background:var(--surface-base); display:flex; align-items:center; justify-content:center; min-height:240px; padding:40px; }
  .prop-group { display:flex; flex-direction:column; gap:8px; }
  .prop-row { flex-direction:row !important; align-items:center; justify-content:space-between; }
  .prop-label { font-size:12px; font-weight:600; color:var(--txt-secondary); }
  .prop-pills { display:flex; flex-wrap:wrap; gap:6px; }
  .pill { padding:5px 11px; font-size:12px; font-weight:500; border-radius:var(--r-md); border:1px solid var(--border); background:#fff; color:var(--txt-secondary); cursor:pointer; transition:all .15s; font-family:var(--font-body); }
  .pill.active { background:var(--prim-500); color:#fff; border-color:var(--prim-500); }
  .pill:hover:not(.active) { border-color:var(--prim-500); color:var(--prim-600); }
  .prop-input { padding:7px 10px; font-size:13px; border:1px solid var(--border); border-radius:var(--r-md); font-family:var(--font-body); color:var(--txt-primary); background:#fff; outline:none; width:100%; box-sizing:border-box; }
  .prop-input:focus { border-color:var(--prim-500); box-shadow:0 0 0 2px rgba(81,163,163,.15); }
  .ctrl-toggle { display:inline-flex; align-items:center; cursor:pointer; }
  .ctrl-toggle input { display:none; }
  .ctrl-track { width:40px; height:22px; background:var(--neutral-300); border-radius:999px; position:relative; transition:background .2s; flex-shrink:0; display:inline-block; }
  .ctrl-track::after { content:''; position:absolute; top:2px; left:2px; width:18px; height:18px; background:#fff; border-radius:50%; transition:transform .2s; box-shadow:0 1px 3px rgba(0,0,0,.2); }
  .ctrl-toggle input:checked ~ .ctrl-track { background:var(--prim-500); }
  .ctrl-toggle input:checked ~ .ctrl-track::after { transform:translateX(18px); }
  /* Icon picker */
  .icon-picker { display:flex; flex-wrap:wrap; gap:4px; }
  .icon-pill { width:30px; height:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:var(--r-md); border:1px solid var(--border); background:#fff; cursor:pointer; color:var(--txt-secondary); transition:all .15s; padding:0; }
  .icon-pill.active { background:var(--prim-100); border-color:var(--prim-500); color:var(--prim-600); }
  .icon-pill:hover:not(.active) { border-color:var(--prim-500); color:var(--prim-600); }
  .prop-inline { display:flex; align-items:center; justify-content:space-between; }
</style>
