---
import Layout from '../layouts/Layout.astro';
import { config } from '../lib/tokens';
const iniciales = (config.marca ?? 'DS').split(/\s+/).map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Dashboard" section="dashboard">
  <div class="hero">
    <div class="hero-glow"></div>

    <div class="hero-badge">{iniciales}</div>

    <h1 class="hero-title">{config.cliente ?? 'Sistema de Diseño'}</h1>
    <p class="hero-meta">v{config.version} &nbsp;·&nbsp; base {config.base} &nbsp;·&nbsp; {String(config.generado ?? '').slice(0, 4)}</p>

    <div class="hero-links">
      <a href={`${base}/tokens/colors`} class="hero-link">
        <span class="hero-link-name">
          Tokens
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="hero-link-desc">Colores, tipografía, espaciado y radios de borde.</span>
      </a>

      <a href={`${base}/components/buttons`} class="hero-link">
        <span class="hero-link-name">
          Components
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="hero-link-desc">Botones, campos, selecciones y notificaciones.</span>
      </a>

      <a href={`${base}/support`} class="hero-link">
        <span class="hero-link-name">
          Support us
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="hero-link-desc">Archivo Figma, recursos y contribuciones.</span>
      </a>
    </div>
  </div>
</Layout>

<style>
  .hero {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: calc(100vh - 80px); text-align: center; position: relative;
  }
  .hero-glow {
    position: absolute; width: 560px; height: 560px; border-radius: 50%; pointer-events: none;
    top: 50%; left: 50%; transform: translate(-50%, -56%);
    background: radial-gradient(circle, color-mix(in srgb, var(--prim-500) 14%, transparent) 0%, transparent 64%);
  }
  .hero-badge {
    width: 64px; height: 64px; border-radius: calc(var(--r-lg) + 4px);
    background: linear-gradient(145deg, var(--prim-500) 0%, var(--prim-800) 100%);
    color: #fff; font-size: 20px; font-weight: 600; letter-spacing: -0.5px;
    display: flex; align-items: center; justify-content: center; margin-bottom: 28px; position: relative;
    box-shadow: 0 12px 32px -10px color-mix(in srgb, var(--prim-700) 55%, transparent);
  }
  .hero-title {
    font-family: var(--font-display); font-size: 40px; font-weight: 600; color: var(--txt-primary);
    letter-spacing: -0.03em; margin-bottom: 10px; line-height: 1.1; position: relative;
  }
  .hero-meta { font-size: 13px; color: var(--txt-tertiary); margin-bottom: 56px; position: relative; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; position: relative; }
  .hero-link {
    text-decoration: none; text-align: left; display: flex; flex-direction: column; gap: 6px; width: 232px;
    padding: 20px 22px; border-radius: var(--r-card);
    background: var(--glass); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-edge); box-shadow: var(--shadow-low); transition: box-shadow .2s;
  }
  .hero-link:hover { box-shadow: var(--shadow-mid); }
  .hero-link-name { font-size: 15px; font-weight: 600; color: var(--txt-primary); display: flex; align-items: center; justify-content: space-between; gap: 5px; }
  .hero-link-desc { font-size: 13px; color: var(--txt-tertiary); line-height: 1.5; }
</style>
