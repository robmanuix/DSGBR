---
import { existsSync, readFileSync } from 'node:fs';
import Layout from '../layouts/Layout.astro';
import { config } from '../lib/tokens';

const subNav = [
  { label: 'Support us', href: '/support', id: 'support' },
  { label: 'Historial', href: '/historial', id: 'historial' },
];
const doc = existsSync('tokens/historial.json') ? JSON.parse(readFileSync('tokens/historial.json', 'utf8')) : null;
const versiones: { version: string; fecha: string; cliente: string; notas: string }[] = doc?.versiones ?? [];
const fmt = (f: string) => { const [a, m, d] = f.split('-').map(Number); return a ? new Date(Date.UTC(a, m - 1, d)).toLocaleDateString('es', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : f; };
---
<Layout title="Historial" section="support" subNav={subNav} pageTitle="Historial" pageDesc={`Versiones publicadas del sistema de diseño de ${config.cliente ?? 'la marca'}.`}>
  {versiones.length === 0 ? (
    <div class="hist-vacio">
      <h2>Aún no hay versiones publicadas</h2>
      <p>El historial se arma con cada publicación hecha desde el plugin de Figma. Escribe «Notas de esta versión» antes de publicar para que aparezcan aquí.</p>
    </div>
  ) : (
    <ol class="hist">
      {versiones.map((v, i) => (
        <li class="hist-item">
          <div class="hist-cab">
            <span class="hist-version">v{v.version}</span>
            {i === 0 && <span class="hist-actual">Actual</span>}
            <time class="hist-fecha" datetime={v.fecha}>{fmt(v.fecha)}</time>
          </div>
          {v.notas
            ? <p class="hist-notas">{v.notas}</p>
            : <p class="hist-notas hist-sin">Sin notas.</p>}
        </li>
      ))}
    </ol>
  )}
</Layout>

<style is:global>
  .hist { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; max-width: 720px; }
  .hist-item { background: var(--surface-card); border: 1px solid var(--border); border-radius: var(--r-card); padding: 18px 22px; box-shadow: var(--shadow-low); }
  .hist-cab { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }
  .hist-version { font-size: 17px; font-weight: 600; letter-spacing: -.01em; color: var(--txt-primary); }
  .hist-actual { font-size: 12px; font-weight: 500; padding: 2px 10px; border-radius: 999px; background: var(--txt-primary); color: var(--surface-card); }
  .hist-fecha { margin-left: auto; font-size: 13px; color: var(--txt-tertiary); }
  .hist-notas { margin: 0; font-size: 15px; line-height: 1.6; color: var(--txt-primary); white-space: pre-line; }
  .hist-sin { color: var(--txt-tertiary); }
  .hist-vacio { max-width: 560px; padding: 28px; border: 1px dashed var(--border); border-radius: var(--r-card); background: var(--surface-card); }
  .hist-vacio h2 { font-size: 17px; font-weight: 600; margin: 0 0 8px; color: var(--txt-primary); }
  .hist-vacio p { margin: 0; font-size: 14px; line-height: 1.6; color: var(--txt-secondary); }
</style>
