---
import Layout from '../../layouts/Layout.astro';
import { primColors, semColors } from '../../data/tokens.js';

const subNav = [
  { label: 'Colores',       href: '/tokens/colors',       id: 'colors' },
  { label: 'Tipografía',    href: '/tokens/typography',   id: 'typography' },
  { label: 'Espaciado',     href: '/tokens/spacing',      id: 'spacing' },
  { label: 'Border Radius', href: '/tokens/border-radius',id: 'border-radius' },
  { label: 'Elevaciones',   href: '/tokens/elevations',   id: 'elevations' },
  { label: 'Variables',     href: '/tokens/variables',     id: 'variables' },
  { label: 'Descargas',     href: '/tokens/descargas',     id: 'descargas' },
];

const primGroups = [...new Set(primColors.map((c) => c.group))];
const semGroups = [...new Set(semColors.map((c) => c.group))];

function byGroup(arr, group) { return arr.filter(c => c.group === group); }

function isLight(hex) {
  const r = parseInt(hex.slice(1,3),16)/255;
  const g = parseInt(hex.slice(3,5),16)/255;
  const b = parseInt(hex.slice(5,7),16)/255;
  return (0.299*r + 0.587*g + 0.114*b) > 0.6;
}
---
<Layout title="Colores" section="tokens" subNav={subNav} pageTitle="Colores" pageDesc="Paleta de colores primitivos y tokens semánticos del sistema.">

  <div class="search-bar">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="6" cy="6" r="4.5" stroke="#9ea3ab" stroke-width="1.4"/><path d="M10 10L12.5 12.5" stroke="#9ea3ab" stroke-width="1.4" stroke-linecap="round"/></svg>
    <input id="search" type="text" placeholder="Buscar token..." />
  </div>

  <!-- Primitivos -->
  <p class="section-label">Paleta Primitiva</p>
  {primGroups.map(group => {
    const items = byGroup(primColors, group);
    return (
      <div>
        <div class="group-header">
          <span class="group-title">{group}</span>
          <span class="group-count">{items.length}</span>
        </div>
        <div class="token-grid">
          {items.map(c => (
            <div class="token-card" data-searchable={c.name}>
              <div class="token-swatch" style={`background:${c.hex}`}></div>
              <div class="token-body">
                <div class="token-name">{c.name}</div>
                <div class="token-meta">
                  <span class="token-value">{c.hex}</span>
                  <button class="copy-btn" data-copy={c.hex}>
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><rect x="4" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.3"/><path d="M2 8H1.5A.5.5 0 0 1 1 7.5V1.5A.5.5 0 0 1 1.5 1H7.5A.5.5 0 0 1 8 1.5V2" stroke="currentColor" stroke-width="1.3"/></svg>
                    Copiar
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  })}

  <!-- Semánticos -->
  <p class="section-label" style="margin-top:40px">Tokens Semánticos</p>
  <p style="font-size:13px;color:var(--txt-tertiary);margin-bottom:20px">
    Los tokens semánticos tienen dos modos: ☀️ Claro y 🌑 Oscuro. Los valores mostrados corresponden al modo claro.
  </p>
  {semGroups.map(group => {
    const items = byGroup(semColors, group);
    return (
      <div>
        <div class="group-header">
          <span class="group-title">{group}</span>
          <span class="group-count">{items.length}</span>
        </div>
        <div class="token-grid-wide">
          {items.map(c => (
            <div class="token-card sem-card" data-searchable={c.name}>
              <div class="sem-swatch" style={`background:${c.hex}`}>
                <span class="sem-preview" style={`color:${isLight(c.hex) ? '#151a1f' : '#f9f9f9'}`}>Aa</span>
              </div>
              <div class="token-body">
                <div class="token-name">{c.name}</div>
                <div class="token-meta">
                  <span class="token-value">{c.hex}</span>
                  <button class="copy-btn" data-copy={c.name}>Copiar token</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    );
  })}
</Layout>

<style is:global>
  .sem-swatch { height: 56px; display:flex; align-items:center; justify-content:flex-end; padding:0 12px; }
  .sem-preview { font-size: 22px; font-weight: 700; opacity: .7; }
</style>
