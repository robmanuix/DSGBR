---
import Layout from '../../layouts/Layout.astro';
import { textStyles, textCategories, fontFamily } from '../../data/tokens.js';

const subNav = [
  { label: 'Colores',       href: '/tokens/colors',        id: 'colors' },
  { label: 'Tipografía',    href: '/tokens/typography',    id: 'typography' },
  { label: 'Espaciado',     href: '/tokens/spacing',       id: 'spacing' },
  { label: 'Border Radius', href: '/tokens/border-radius', id: 'border-radius' },
  { label: 'Elevaciones',   href: '/tokens/elevations',    id: 'elevations' },
  { label: 'Variables',     href: '/tokens/variables',     id: 'variables' },
  { label: 'Descargas',     href: '/tokens/descargas',     id: 'descargas' },
];

const categories = textCategories;
const weightMap: Record<string,number> = { Regular:400, Medium:500, SemiBold:600, Bold:700, ExtraBold:800 };

const cssRef = `:root {\n  --font-family-brand: '${fontFamily}', system-ui, sans-serif;\n${textStyles.map((t) => `  --font-size-${t.name.split('/')[1].toLowerCase()}: ${t.fontSize}px;`).join('\n')}\n}`;
function cssWeight(w: string) { return weightMap[w] ?? 400; }
---
<Layout title="Tipografía" section="tokens" subNav={subNav} pageTitle="Tipografía" pageDesc={`${textStyles.length} estilos de texto en ${fontFamily}: tamaños, pesos y alturas de línea.`}>

  {categories.map(cat => {
    const items = textStyles.filter(t => t.category === cat);
    return (
      <div>
        <p class="section-label">{cat}</p>
        <div class="type-list">
          {items.map(t => {
            const cssSnippet = `font-family: '${t.family}', system-ui, sans-serif;
font-size: ${t.fontSize}px;
font-weight: ${cssWeight(t.weight)};
line-height: ${t.lineHeight}px;`;
            return (
              <div class="type-card">
                <div class="type-preview" style={`font-family:'${t.family}',$system-ui,sans-serif;font-size:${Math.min(t.fontSize, 48)}px;font-weight:${cssWeight(t.weight)};line-height:1.2`}>
                  Sistema de Diseño
                </div>
                <div class="type-meta">
                  <div class="type-info">
                    <span class="token-name">{t.name}</span>
                    <div class="type-details">
                      <span class="tag tag-neutral">{t.family}</span>
                      <span class="tag tag-neutral">{t.fontSize}px</span>
                      <span class="tag tag-neutral">{t.weight}</span>
                      <span class="tag tag-neutral">lh {t.lineHeight}px</span>
                    </div>
                  </div>
                  <button class="copy-btn" data-copy={cssSnippet}>
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><rect x="4" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.3"/><path d="M2 8H1.5A.5.5 0 0 1 1 7.5V1.5A.5.5 0 0 1 1.5 1H7.5A.5.5 0 0 1 8 1.5V2" stroke="currentColor" stroke-width="1.3"/></svg>
                    Copiar CSS
                  </button>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    );
  })}

  <!-- CSS variables reference -->
  <p class="section-label" style="margin-top:40px">Variables CSS de referencia</p>
  <div class="code-block">
    <button class="copy-btn" data-copy={cssRef}>Copiar</button>
    <pre>{cssRef}</pre>
  </div>
</Layout>

<style is:global>
  .type-list { display: flex; flex-direction: column; gap: 2px; margin-bottom: 8px; }
  .type-card {
    background: #fff; border: 1px solid var(--border); border-radius: var(--r-md);
    padding: 20px 24px; display: flex; flex-direction: column; gap: 16px;
    box-shadow: var(--shadow-low);
  }
  .type-preview { color: var(--txt-primary); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .type-meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; border-top: 1px solid var(--border); padding-top: 12px; }
  .type-info { display: flex; flex-direction: column; gap: 6px; }
  .type-details { display: flex; gap: 6px; flex-wrap: wrap; }
</style>
